#!/bin/bash
# Server helper for the okx-agent portfolio bot (own Demo account). Installed as /usr/local/bin/okx-portfolio.
#   okx-portfolio diagnose   read-only key/account check (no orders)
#   okx-portfolio start      diagnose + refuse the carry bot's account, then start (also after reboots)
#   okx-portfolio stop       ask the bot to stop; it drains (protections confirmed) and exits, then stays off
#   okx-portfolio status     bot status JSON
#   okx-portfolio logs       last 100 log lines (add -f to follow)
set -euo pipefail
APP=/opt/okx-portfolio/app
UNIT=okx-portfolio.service

as_bot() {   # runs as okxbot with the key file, keys never on a command line
    systemd-run --quiet --wait --pipe --collect --uid=okxbot --gid=okxbot \
        --property=EnvironmentFile=/etc/okx-portfolio/portfolio.env \
        --property=Environment="PYTHONDONTWRITEBYTECODE=1 PYTHONIOENCODING=utf-8" \
        --working-directory="$APP" /usr/bin/python3 "$@"
}

case "${1:-}" in
    diagnose)
        as_bot futures_testnet_portfolio.py diagnose
        ;;
    start)
        if systemctl is-active --quiet "$UNIT"; then echo "bot zaten calisiyor"; exit 0; fi
        echo "hesap ayri mi kontrol ediliyor (carry botunun pozisyon/emri olmamali)..."
        rc=0; as_bot /opt/okx-portfolio/check-separate-account.py || rc=$?
        if [ "$rc" -eq 1 ]; then
            echo "DURDU: bu anahtar carry botunun hesabina ait gorunuyor; ayri Demo hesabin anahtarini girin"; exit 1
        elif [ "$rc" -ne 0 ]; then
            echo "DURDU: hesap okunamadi (code=-2015: anahtar/secret hatali, IP kisitlamasi veya Futures izni yok)"; exit 1
        fi
        echo "anahtar ve hesap kontrolu (diagnose)..."
        if ! as_bot futures_testnet_portfolio.py diagnose; then echo "diagnose basarisiz; bot baslatilmadi"; exit 1; fi
        systemctl enable --now "$UNIT"
        sleep 5
        systemctl --no-pager --lines=5 status "$UNIT" || true
        ;;
    stop)
        as_bot futures_testnet_portfolio.py stop
        systemctl disable "$UNIT" >/dev/null 2>&1 || true
        echo "durma istendi; bot korumalari dogrulayip kendisi cikar (bekleniyor, en fazla 5 dk)..."
        for _ in $(seq 60); do systemctl is-active --quiet "$UNIT" || { echo "bot durdu"; exit 0; }; sleep 5; done
        echo "bot hala bosaltiyor; 'okx-portfolio status' ile izleyin (zorla durdurmak: systemctl stop $UNIT)"
        ;;
    status)
        systemctl is-active "$UNIT" || true
        as_bot futures_testnet_portfolio.py status | head -80
        ;;
    logs)
        shift
        journalctl -u "$UNIT" --no-pager -n 100 "$@"
        ;;
    *)
        echo "kullanim: okx-portfolio {diagnose|start|stop|status|logs}"; exit 2
        ;;
esac
