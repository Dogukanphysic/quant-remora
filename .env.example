# Binance Spot Testnet only. Never commit real values.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_SECRET_KEY=
# Keep empty/false for read-only and /order/test. Set exactly "testnet" only
# when an actual Testnet order is intended.
BINANCE_ORDER_EXECUTION_ENABLED=false
# A background worker also requires this independent gate. The secure start
# script sets both gates only for the detached Spot Testnet process.
BINANCE_TESTNET_WORKER_ENABLED=false
# Monthly Testnet reset recovery is separately gated and archives the prior
# ledger before initializing a fresh epoch. Keep false during normal use.
BINANCE_TESTNET_RESET_ENABLED=false
